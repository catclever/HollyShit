+-    )
+-    
+-    return parser.parse_args()
+-
+-def main():
+-    args = get_args()
+-    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+-    os.makedirs(args.out_dir, exist_ok=True)
