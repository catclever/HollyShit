+-    god_encoder = GodEncoder(d_model, z_dim)
+-
+-    print(f"Loading Frozen Teacher weights from {args.p0_ckpt}...")
+-    fuser.load_weights(fuser_path)
+-    god_encoder.load_weights(god_path)
