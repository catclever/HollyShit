+-            import mlx.core as mx
+-            token_inputs = mx.array(padded_ids)
+-            attention_mask = mx.array(masks)
+-            batch_embs = [mx.array(arr[batch_indices]) for arr in self.embs]
+-        
+-        self.batch_idx += 1
