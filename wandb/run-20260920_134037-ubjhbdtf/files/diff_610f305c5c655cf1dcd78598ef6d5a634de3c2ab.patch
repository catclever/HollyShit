+-        
+-        # 3. Epoch & Batch tracking
+-        self.rng = np.random.default_rng(seed)
+-        self.current_epoch = 0
+-        self.batch_idx = 0
+-        self.indices = np.arange(self.total_samples)
+-        
+-        if self.shuffle:
+-            self.rng.shuffle(self.indices)
