+-        self.prefetch_thread.start()
+-        
+-    def _prefetch_worker(self, start_macro_ptr):
+-        """高强度纯后台下载/解压打工仔，永远走在 GPU 的前面"""
+-        worker_macro_ptr = start_macro_ptr
