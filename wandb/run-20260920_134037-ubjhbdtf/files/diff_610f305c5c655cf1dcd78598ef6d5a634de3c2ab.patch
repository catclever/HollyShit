+-        # Self-Attention Block with AdaLN
+-        x_norm = self.ln1(x)
+-        x_mod = x_norm * (1 + scale_a) + shift_a
+-        attn_out, _ = self.attn(x_mod, x_mod, x_mod)
+-        x = x + gate_a * attn_out
+-        
+-        # MLP Block with AdaLN
+-        x_norm2 = self.ln2(x)
+-        x_mod2 = x_norm2 * (1 + scale_m) + shift_m
+-        mlp_out = self.mlp(x_mod2)
+-        x = x + gate_m * mlp_out
+-        
+-        return x
