+-    def forward(self, x, cond):
+-        # x: (B, L, d_model)
+-        # cond: (B, dim_cond)
+-        ada_params = self.cond_proj(cond) # (B, d_model * 6)
+-        ada_params = ada_params.unsqueeze(1) # (B, 1, d_model * 6)
