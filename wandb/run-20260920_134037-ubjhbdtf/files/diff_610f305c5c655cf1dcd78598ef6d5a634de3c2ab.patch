+-    for key, tensor in fuser_state.items():
+-        m = re.match(r"adapters\.(\d+)\.(?:net\.layers\.0|fc1)\.weight$", key)
+-        if m:
+-            idx = int(m.group(1))
+-            route_dims[idx] = int(tensor.shape[1])
