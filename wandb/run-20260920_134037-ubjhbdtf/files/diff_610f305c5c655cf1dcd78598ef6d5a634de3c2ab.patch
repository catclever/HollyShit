+from tools.weight_utils import load_torch_weights_into_mlx
+
+# Removed pad_chunks as it is no longer needed.
+
+
+def loss_fn(model, c, targets, pad_id):
+    import mlx.nn as nn
+    import mlx.core as mx
+    # model(c) -> [B, L, V]
+    logits = model(c) 
+    
+    # targets: [B, L]
+    B, L = targets.shape
+    
+    logits = logits.reshape(B * L, -1)
+    targets = targets.reshape(-1)
+    
+    # Calculate cross entropy loss
+    loss = nn.losses.cross_entropy(logits, targets, reduction='none')
+    
+    # We NO LONGER mask out padding tokens!
+    # By forcing the model to reconstruct pad_id perfectly, it will learn that [PAD] embeddings
+    # map to [PAD] tokens, eliminating the trailing gibberish.
+    loss = mx.mean(loss)
+    
+    return loss
+
+def train():
+    import wandb
