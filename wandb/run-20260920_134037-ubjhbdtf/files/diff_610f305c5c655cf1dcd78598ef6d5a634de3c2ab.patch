+-        print(f"[DataLoader] 正在装载基准文本体系: {parquet_path}...")
+-        df = pd.read_parquet(parquet_path)
+-        self.text_chunks = df['chunks'].explode().dropna().tolist()
+-        self.total_samples = len(self.text_chunks)
