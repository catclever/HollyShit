+-def _is_checkpoint_dir_name(folder_name: str):
+-    if folder_name == "latest_emergency" or folder_name.startswith("step_"):
+-        return True
+-    if folder_name.endswith("_latest_emergency"):
+-        return True
+-    return bool(re.match(r".+_step_\d+$", folder_name))
