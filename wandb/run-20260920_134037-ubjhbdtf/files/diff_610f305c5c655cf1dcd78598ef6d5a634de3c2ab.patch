+-        try:
+-            with open(state_file, "r", encoding="utf-8") as f:
+-                state = json.load(f)
+-            return int(state.get("global_step", -1))
+-        except Exception:
+-            pass
+-    m = re.search(r"_step_(\d+)$", folder_name)
+-    if m:
+-        return int(m.group(1))
+-    m = re.match(r"step_(\d+)$", folder_name)
+-    if m:
+-        return int(m.group(1))
+-    return -1
