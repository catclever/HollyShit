+-                    loss_infonce = F.cross_entropy(logits, labels)
+-                    
+-                    # --- 3. WeakDecoder CE Loss (Semantic Anchoring) ---
+-                    decoder_inputs = token_inputs[:, :-1]
+-                    decoder_targets = token_inputs[:, 1:]
+-                    decoder_logits = decoder(z_pred, decoder_inputs)
