+def get_1d_sincos_pos_embed_mlx(embed_dim, length):
+    """
+    Creates 1D sinusoidal positional embeddings in MLX.
+    Returns: [length, embed_dim]
+    """
+    pos = mx.arange(length, dtype=mx.float32)
+    omega = mx.arange(embed_dim // 2, dtype=mx.float32)
+    omega = omega / (embed_dim / 2.0)
+    omega = 1.0 / (10000.0 ** omega)
