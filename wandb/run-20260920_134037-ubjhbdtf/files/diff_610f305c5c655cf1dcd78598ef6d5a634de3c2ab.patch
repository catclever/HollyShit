+-        new_k = new_k.replace(".net.layers.2.", ".fc2.")
+-        new_k = new_k.replace("net.layers.0.", "fc1.")
+-        new_k = new_k.replace("net.layers.2.", "fc2.")
+-        new_k = new_k.replace(".norm.", ".norm.") # Unchanged, just to be explicit
+-        remapped[new_k] = v
