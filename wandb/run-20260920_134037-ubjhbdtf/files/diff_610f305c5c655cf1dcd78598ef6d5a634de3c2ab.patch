+-        
+-        flat_idx = 0
+-        for b, doc in enumerate(batch_docs_sentences):
+-            for s, _ in enumerate(doc):
+-                seq = encoded_list[flat_idx]
+-                seq_len = len(seq)
+-                padded_ids[b, s, :seq_len] = seq
+-                attention_mask[b, s, :seq_len] = 1.0
+-                sentence_mask[b, s] = 1.0
