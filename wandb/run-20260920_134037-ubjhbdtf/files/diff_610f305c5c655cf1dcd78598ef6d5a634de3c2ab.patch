+            padded_tokens = np.full((len(batch_texts), max_len), tokenizer.pad_token_id, dtype=np.int32)
+            for j, tk in enumerate(batch_tokens):
+                padded_tokens[j, :len(tk)] = tk
+                
+            mx_x = mx.array(padded_tokens)
+            h, diffs = encode_batch(mx_x)
+            
