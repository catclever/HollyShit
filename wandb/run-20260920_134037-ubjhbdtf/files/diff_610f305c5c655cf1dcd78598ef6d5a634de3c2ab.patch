+-    print(f"========================================================\n")
+-    
+-    try:
+-        for epoch in range(dataloader.current_epoch, args.epochs):
+-            for token_inputs, batch_embs, attention_mask in dataloader:
+-                global_step += 1
+-                if len(batch_embs) != len(emb_dims):
