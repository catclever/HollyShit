+-                print(f"[DataLoader] 这不是致命错误！打工仔将在 10 秒后原地重新尝试拉取 Chunk {chunk_idx}...")
+-                import time
+-                time.sleep(10)
+-                continue
+-
+-    loader._prefetch_worker = _prefetch_worker_routed
+-    return loader
