+-        elif k.endswith('.wk.weight'):
+-            state_dict[k.replace('.wk.', '.key_proj.')] = state_dict.pop(k)
+-        elif k.endswith('.wv.weight'):
+-            state_dict[k.replace('.wv.', '.value_proj.')] = state_dict.pop(k)
+-        elif k.endswith('.wo.weight'):
