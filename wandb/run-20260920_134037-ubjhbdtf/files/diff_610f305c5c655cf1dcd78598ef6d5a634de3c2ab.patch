+-        for model_name in loader.models:
+-            pattern = loader.chunk_patterns.get(
+-                model_name, f"{model_name}_chunk_{{start:07d}}_{{end:07d}}.npz"
+-            )
+-            model_end = loader._per_model_bounds.get(model_name, {}).get(start_idx, end_idx)
