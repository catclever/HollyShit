+-        # 异步流水线 (Async Prefetch)
+-        self.prefetch_queue = queue.Queue(maxsize=1) # 内存里永远只多塞一块，极限控流
+-        self.stop_event = threading.Event()
+-        self._started = False
+-        
+-        # 延迟启动：如果要从 checkpoint 恢复，不要在这里白白下载一个块
+-        if not lazy_start:
