+-                        last_err = e
+-                        time.sleep(0.5)
+-                if downloaded_path is None:
+-                    raise last_err
+-                downloaded_path = os.path.abspath(downloaded_path)
+-            else:
+-                downloaded_path = os.path.join(local_data_dir, cand_name)
