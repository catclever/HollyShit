+-        if self.active_micro_ptr >= len(self.active_micro_indices):
+-            try:
+-                self._pop_next_chunk()
+-            except StopIteration:
+-                # 一个 Epoch 完结！
+-                self.current_epoch += 1
+-                if self.shuffle:
+-                    self.rng.shuffle(self.macro_chunk_indices)
