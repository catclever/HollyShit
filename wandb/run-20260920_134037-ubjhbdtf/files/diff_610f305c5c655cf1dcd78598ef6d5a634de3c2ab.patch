+-        # Scale continuous t in [0,1] to [0, 1000] to give the sinusoidal embeddings proper high-frequency resolution.
+-        # Otherwise, for t in [0, 1], the arguments to sin/cos never even complete a single period!
+-        t_scaled = t * 1000.0
