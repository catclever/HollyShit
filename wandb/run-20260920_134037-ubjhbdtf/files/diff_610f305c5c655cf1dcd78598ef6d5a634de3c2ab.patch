+-class NARFlowMatcher(nn.Module):
+-    """
+-    Conditional Sequence Flow Matcher (MLX Version).
+-    """
+-    def __init__(self, z_dim: int, x_dim: int, d_model: int = 512, n_layers: int = 6, n_heads: int = 8, max_seq_len: int = 64):
