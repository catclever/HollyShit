+-def custom_lr_schedule(global_step: int, max_lr: float, warmup_steps: int):
+-    # Absolute linear warmup from 0
+-    if global_step < warmup_steps:
+-        return max_lr * (global_step / warmup_steps)
+-    return max_lr
