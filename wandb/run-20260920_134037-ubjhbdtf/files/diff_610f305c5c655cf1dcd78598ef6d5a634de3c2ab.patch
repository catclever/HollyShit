+-def resolve_path_maybe_relative(path_value: str, base_dir: str):
+-    if not path_value:
+-        return path_value
+-    if os.path.isabs(path_value):
+-        return path_value
+-    candidate = os.path.join(base_dir, path_value)
+-    if os.path.exists(candidate):
+-        return candidate
+-    return path_value
