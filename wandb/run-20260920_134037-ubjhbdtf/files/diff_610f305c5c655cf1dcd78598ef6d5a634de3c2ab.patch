+-class NARFlowMatcherCUDA(nn.Module):
+-    """
+-    Conditional Sequence Flow Matcher (PyTorch CUDA Version).
+-    Predicts the vector field v_t given intermediate flow state X_t, timestep t, and macro condition Z_macro.
+-    """
