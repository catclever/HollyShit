+-            
+-            # Interpolated flow state: X_t = t * X_1 + (1 - t) * X_0
+-            t_expand = t.view(B, 1, 1)
+-            X_t = t_expand * X_1 + (1.0 - t_expand) * X_0
+-            
+-            # Ground truth velocity vector field: U_t = X_1 - X_0
+-            U_t = X_1 - X_0
+-            
