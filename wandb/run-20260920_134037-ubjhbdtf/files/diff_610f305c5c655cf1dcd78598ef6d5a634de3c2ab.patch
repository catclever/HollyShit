+-        new_k = k
+-        new_k = new_k.replace("mlp.0.", "mlp.layers.0.")
+-        new_k = new_k.replace("mlp.2.", "mlp.layers.2.")
+-        new_k = new_k.replace("z_proj.0.", "z_proj.layers.0.")
+-        new_k = new_k.replace("z_proj.2.", "z_proj.layers.2.")
